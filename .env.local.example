# Local env for the standalone AI Gateway test script (index.mjs).
# Copy to .env.local and fill in. This file is gitignored.

# A Vercel AI Gateway API key (starts with vck_). Create one at
# https://vercel.com → AI → API Keys. Needs a card on file to run.
AI_GATEWAY_API_KEY=vck_your_key_here

# Optional: override the default model (defaults to openai/gpt-4o-mini).
# Examples: openai/gpt-5.5, anthropic/claude-opus-4.8, google/gemini-3-flash,
#           deepseek/deepseek-v3.1, google/gemini-2.5-flash-lite
# GATEWAY_MODEL=openai/gpt-4o-mini
