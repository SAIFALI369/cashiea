# ──────────────────────────────────────────────
# Cashiea — Environment Variables
# Copy this file to `.env` and fill in your values
# ──────────────────────────────────────────────

# Supabase (get these from your Supabase project dashboard)
VITE_SUPABASE_URL=https://prwvaetatdidsugczluv.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_g4yCnzuqnl15agWnroOgMg_C5rB9z_u

# Default AI provider: openai | gemini | anthropic
VITE_DEFAULT_AI_PROVIDER=openai

# Set to 'true' ONLY after you've configured Stripe (see README → Stripe Setup).
# When false, plan upgrades run in demo mode (instant, no payment).
VITE_STRIPE_ENABLED=false

# OpenRouter (recommended — one key, 300+ models, auto-fallback):
#   Get a key at https://openrouter.ai/keys
#   supabase secrets set OPENROUTER_API_KEY=sk-or-v1-...
#   Then pick 'OpenRouter' in Settings (or set as the default below).
#   Fallback chain: Gemini → Kimi K3 → Llama → any free model.
#
# ──────────────────────────────────────────────
# Google OAuth (optional — for live Gmail / Sheets sync):
#   1. Create OAuth client at console.cloud.google.com
#   2. Redirect URI: https://<project>.functions.supabase.co/google-oauth
#   3. Enable Gmail API + Google Sheets API
#   supabase secrets set GOOGLE_CLIENT_ID=....apps.googleusercontent.com
#   supabase secrets set GOOGLE_CLIENT_SECRET=...
#
# Email delivery (Resend) — for support form, campaign delivery,
# and the daily morning briefing:
#   supabase secrets set RESEND_API_KEY=re_...
#   supabase secrets set MAIL_FROM=you@yourdomain.com
#
# Daily AI Brain cron:
#   supabase functions deploy daily-brain
#   Then schedule via Supabase Dashboard → Database → Scheduled Functions
#   to POST to /daily-brain with the service role key at 7:00 AM daily.
# ──────────────────────────────────────────────
