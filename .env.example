# ──────────────────────────────────────────────
# BizAutomate AI — Environment Variables
# Copy this file to `.env` and fill in your values
# ──────────────────────────────────────────────

# Supabase (get these from your Supabase project dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Default AI provider: openai | gemini | anthropic
VITE_DEFAULT_AI_PROVIDER=openai

# ──────────────────────────────────────────────
# IMPORTANT: AI API keys should ONLY be set as
# Supabase Edge Function secrets, NOT here!
# Set them with:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set ANTHROPIC_API_KEY=...
# ──────────────────────────────────────────────
