# ──────────────────────────────────────────────
# Cashiea — Environment Variables
# Copy this file to `.env.local` and fill in your values
# ──────────────────────────────────────────────

# Supabase (get these from your Supabase project → Settings → API)
# Cashiea's live project is prwvaetatdidsugczluv (see supabase/config.toml).
# Do NOT use the old oxlwbxkifyrhggrsaoin project — it no longer resolves.
VITE_SUPABASE_URL=https://prwvaetatdidsugczluv.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional observability (off by default; no tracking without these) ──
# Cookieless analytics (Plausible): your domain, e.g. cashiea.vercel.app.
# Also enables lightweight runtime-error events; self-hosted instances work
# by pointing VITE_PLAUSIBLE_SRC at the instance's script URL.
# VITE_PLAUSIBLE_DOMAIN=
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js
